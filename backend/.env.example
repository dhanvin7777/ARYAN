# ==========================================
# ARYAN Backend - Environment Configuration
# ==========================================

# Server Port (Render injects PORT automatically in production)
PORT=5000
NODE_ENV=development

# Frontend URL for CORS Whitelisting
# In Render dashboard, set this to your Vercel URL (e.g., https://aryan.vercel.app)
FRONTEND_URL=https://your-frontend-app.vercel.app

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# From Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------
# Supabase PostgreSQL Connection Pooler URI
# ------------------------------------------
# From Supabase Dashboard -> Project Settings -> Database -> Connection String (URI, Mode: Transaction or Session)
# Render requires pooler mode for IPv4 compatibility!
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------
# TinyFish AI Web Agent Configuration
# ------------------------------------------
# From https://agent.tinyfish.ai/api-keys:
TINYFISH_API_KEY=sk-tinyfish-your-secret-api-key-here

