# ==========================================
# ARYAN Frontend - Environment Configuration
# ==========================================

# Render Backend API URL
# In local development: http://localhost:5000/api
# In Vercel Environment Variables: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Supabase Public Keys (Optional on frontend, required if using direct Supabase client or Auth)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
